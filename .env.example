# Server-only Supabase configuration.
# Do NOT prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Legacy projects may temporarily use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel Cron automatically sends: Authorization: Bearer <CRON_SECRET>
# Use a long random value.
CRON_SECRET=replace-with-a-long-random-secret
